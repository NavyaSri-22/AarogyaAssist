# For Supabase PostgreSQL, set DATABASE_URL in the deployment environment.
# Leave DATABASE_URL unset for local MySQL development.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aarogya_assist

JWT_SECRET_KEY=replace-with-a-private-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=replace-with-a-private-groq-key
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
